#!/bin/sh
# Wrapper "npx" colocated with ./node and ./npm, for parity with a real Node bin
# directory in case Zed resolves npx as a sibling of `node.path`. Plain
# passthrough to Node 22's npx, invoked through the real Node binary explicitly.

NODE_BIN="/Users/andrewfraser/.local/share/fnm/node-versions/v22.12.0/installation/bin/node"
NPX_CLI="/Users/andrewfraser/.local/share/fnm/node-versions/v22.12.0/installation/lib/node_modules/npm/bin/npx-cli.js"

exec "$NODE_BIN" "$NPX_CLI" "$@"
