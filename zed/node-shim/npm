#!/bin/sh
# Wrapper "npm" colocated with ./node so Zed (which resolves npm as a sibling of
# `node.path`) finds it. Zed uses npm to install the Solidity LSP package and to
# `npm exec` the ACP agent servers. Plain passthrough to Node 22's npm — the
# crypto shim isn't needed here (only the LSP's solc-js validation path hits it),
# and npm is invoked through the real Node binary explicitly so it doesn't depend
# on `node` being on PATH.

NODE_BIN="/Users/andrewfraser/.local/share/fnm/node-versions/v22.12.0/installation/bin/node"
NPM_CLI="/Users/andrewfraser/.local/share/fnm/node-versions/v22.12.0/installation/lib/node_modules/npm/bin/npm-cli.js"

exec "$NODE_BIN" "$NPM_CLI" "$@"
